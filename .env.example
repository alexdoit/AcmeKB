# Copy to .env (never commit .env). Data API builder reads .env from its working directory.

# Windows authentication against a local SQL Server 2025 instance.
# Named instance: Server=localhost\YOUR_INSTANCE
ACMEKB_CONNECTION_STRING=Server=localhost;Database=AcmeKB;Integrated Security=true;Encrypt=true;TrustServerCertificate=true;Command Timeout=240;

# SQL login with the least-privilege role instead (see README, "Least privilege"):
# ACMEKB_CONNECTION_STRING=Server=localhost;Database=AcmeKB;User Id=acmekb_api;Password=<set-me>;Encrypt=true;TrustServerCertificate=true;Command Timeout=240;
